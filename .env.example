# ---- Server ----
HOST=0.0.0.0
PORT=8000
# Vapi sends a secret in the X-Vapi-Secret header if you configure one; set it here
VAPI_SECRET=

# ---- Stripe (pay-by-link) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_SUCCESS_URL=https://example.com/order-success
STRIPE_CANCEL_URL=https://example.com/order-cancel
# From Stripe dashboard -> Webhooks -> signing secret (verifies /stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Supabase (optional) ----
# When BOTH are set, the app auto-switches from in-memory to Supabase.
# Find these in Supabase -> Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Admin page (HTTP Basic auth) ----
ADMIN_USER=admin
ADMIN_PASS=change_me

# ---- Public base URL of THIS server (so Vapi can reach the tools) ----
# When running locally behind a tunnel, set this to e.g. https://abc.ngrok.io
PUBLIC_BASE_URL=https://your-deploy-url.up.railway.app
